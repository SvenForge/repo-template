[build-system]
requires = [
    "setuptools>=84",
    "setuptools-scm>=10",
]
build-backend = "setuptools.build_meta"

[project]
name = {{ python_distribution_name | tojson }}
dynamic = ["version"]
requires-python = ">={{ python_version }}"
dependencies = []
{% if core_include_readme -%}
readme = "README.md"
{% endif -%}
{% if core_include_license -%}
license = {% if core_license == 'NONE' %}"LicenseRef-Proprietary"{% else %}{{ core_license | tojson }}{% endif %}
license-files = ["LICENSE.md"]
{% endif -%}
{% if core_owner_name -%}
authors = [
    { name = {{ core_owner_name | tojson }}{% if core_owner_email %}, email = {{ core_owner_email | tojson }}{% endif %} },
]
{% endif %}
[dependency-groups]
test = [
    "pytest",
    "pytest-cov",
]
lint = [
    "mypy",
    "mypy-gitlab-code-quality",
    "ruff",
]
dev = [
    { include-group = "test" },
    { include-group = "lint" },
]

[tool.setuptools]
package-dir = { "" = "src" }

[tool.setuptools.packages.find]
where = ["src"]
exclude = ["test_*"]
namespaces = false

[tool.setuptools_scm]
fallback_version = "0.0.0"

[tool.pytest.ini_options]
addopts = [
    "--cov",
    "--cov-report=term-missing",
    "--cov-report=xml:coverage.xml",
    "--junitxml=pytest.xml",
]
testpaths = ["src/test_*"]

[tool.coverage.run]
branch = true
omit = ["test_*"]

[tool.coverage.report]
show_missing = true

[tool.ruff]
src = ["src"]
exclude = [
    ".git",
    "__pycache__",
    "*/.ipynb_checkpoints/*.py",
]
line-length = 200
indent-width = 4

[tool.ruff.lint]
extend-select = [
    "D",    # pydocstyle
    "N",    # pep8-naming
    "Q",    # flake8-quotes
    "COM",  # flake8-commas
    "C4",   # flake8-comprehensions
    "FIX",  # flake8-fixme
    "PTH",  # flake8-use-pathlib
]
ignore = [
    "D212",  # multi-line docstring summary should start at the first line
]

[tool.ruff.lint.flake8-quotes]
inline-quotes = "single"

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.format]
quote-style = "single"

[tool.mypy]
files = ["src"]
strict = true
