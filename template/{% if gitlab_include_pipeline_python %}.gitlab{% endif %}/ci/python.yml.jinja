# Python Pipeline Definition

.python:base:
  image: python:{{ python_version }}-bookworm
  before_script:
    - python -m pip install --constraint env/dev/constraints.txt --upgrade pip
    - python -m pip install --constraint env/dev/constraints.txt --editable . --group "$PYTHON_DEPENDENCY_GROUP"

python:pytest:
  extends: .python:base
  needs: []
  variables:
    PYTHON_DEPENDENCY_GROUP: test
  script:
    - pytest
  artifacts:
    when: always
    reports:
      junit: pytest.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml

python:ruff:
  extends: .python:base
  needs: []
  variables:
    PYTHON_DEPENDENCY_GROUP: lint
  script:
    - ruff check src
    - ruff format --check src

python:mypy:
  extends: .python:base
  needs: []
  variables:
    PYTHON_DEPENDENCY_GROUP: lint
  script:
    - mypy
