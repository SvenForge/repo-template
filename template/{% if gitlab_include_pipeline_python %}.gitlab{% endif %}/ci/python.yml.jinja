# Python Pipeline Definition

.python:base:
  image: python:{{ python_version }}-bookworm
  before_script:
    - python -m pip install --upgrade pip
    - python -m pip install --editable . --group "$PYTHON_DEPENDENCY_GROUP"

python:pytest:
  extends: .python:base
  needs: []
  variables:
    PYTHON_DEPENDENCY_GROUP: test
  script:
    - pytest
  artifacts:
    when: always
    reports:
      junit: pytest.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml

python:ruff:
  extends: .python:base
  needs: []
  variables:
    PYTHON_DEPENDENCY_GROUP: lint
  script:
    - ruff check src --output-format=gitlab --output-file=ruff-code-quality.json || true
    - ruff format --check src || true
  artifacts:
    when: always
    reports:
      codequality: ruff-code-quality.json

python:mypy:
  extends: .python:base
  needs: []
  variables:
    PYTHON_DEPENDENCY_GROUP: lint
  script:
    - mypy --no-error-summary > mypy-out.txt || true
    - mypy-gitlab-code-quality < mypy-out.txt > mypy-code-quality.json
  artifacts:
    when: always
    reports:
      codequality: mypy-code-quality.json
