[project]
name = {{ pyproject.vars.name | tojson }}
{% if pyproject.vars.version -%}
version = {{ pyproject.vars.version | tojson }}
{% else -%}
dynamic = ["version"]
{% endif -%}
requires-python = ">={{ pyproject.vars.python_version }}"
dependencies = []
{%- if pyproject.vars.readme %}
readme = {{ pyproject.vars.readme | tojson }}
{%- endif %}
{%- if pyproject.vars.license %}
license = {% if pyproject.vars.license == 'NONE' %}"LicenseRef-Proprietary"{% else %}{{ pyproject.vars.license | tojson }}{% endif %}
{%- endif %}
{%- if pyproject.vars.license_files %}
license-files = {{ pyproject.vars.license_files | tojson }}
{%- endif %}
{%- if pyproject.vars.owner_name or pyproject.vars.owner_email %}
authors = [
    { {% if pyproject.vars.owner_name %}name = {{ pyproject.vars.owner_name | tojson }}{% if pyproject.vars.owner_email %}, {% endif %}{% endif %}{% if pyproject.vars.owner_email %}email = {{ pyproject.vars.owner_email | tojson }}{% endif %} },
]
{%- endif %}
