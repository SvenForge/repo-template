{% if python.vars.has_distribution or python.vars.has_dev_dependencies or python.vars.tools -%}
{% filter trim -%}
{%- if python.vars.has_distribution %}
[build-system]
requires = [
    "setuptools>=84",
    "setuptools-scm>=10",
]
build-backend = "setuptools.build_meta"

[project]
name = {{ python.vars.distribution_name | tojson }}
dynamic = ["version"]
requires-python = ">={{ python.vars.version }}"
dependencies = []
{%- if python.vars.has_readme %}
readme = "README.md"
{%- endif %}
{%- if python.vars.has_license %}
license = {% if python.vars.license == 'NONE' %}"LicenseRef-Proprietary"{% else %}{{ python.vars.license | tojson }}{% endif %}
license-files = ["LICENSE.md"]
{%- endif %}
{%- if python.vars.owner_name %}
authors = [
    { name = {{ python.vars.owner_name | tojson }}{% if python.vars.owner_email %}, email = {{ python.vars.owner_email | tojson }}{% endif %} },
]
{%- endif %}
{%- endif %}
{%- if python.vars.has_dev_dependencies %}

[dependency-groups]
{%- for contribution in contributions | selectattr('target', 'equalto', 'python.dependency_groups') %}
{% filter trim('\r\n') %}{% include contribution.template %}{% endfilter %}
{%- endfor %}
dev = [
{%- if 'pytest' in python.vars.tools %}
    "pytest",
    "pytest-cov",
{%- endif %}
{%- if 'mypy' in python.vars.tools %}
    "mypy",
    "mypy-gitlab-code-quality",
{%- endif %}
{%- if 'ruff' in python.vars.tools %}
    "ruff",
{%- endif %}
{%- for contribution in contributions | selectattr('target', 'equalto', 'python.dev_dependencies') %}
{% filter trim('\r\n') | indent(4, true) %}{% include contribution.template %}{% endfilter %}
{%- endfor %}
]
{%- endif %}

{%- if python.vars.has_distribution %}

[tool.setuptools]
package-dir = { "" = "src" }

[tool.setuptools.packages.find]
where = ["src"]
exclude = ["test_*"{% if 'pytest' in python.vars.tools and not python.vars.testpackage_name.startswith('test_') %}, {{ python.vars.testpackage_name | tojson }}, {{ (python.vars.testpackage_name ~ '.*') | tojson }}{% endif %}]
namespaces = false

[tool.setuptools_scm]
fallback_version = "0.0.0"
{%- endif %}

{%- if 'pytest' in python.vars.tools %}

[tool.pytest.ini_options]
addopts = [
    "--cov",
    "--cov-report=term-missing",
    "--cov-report=xml:coverage.xml",
    "--junitxml=pytest.xml",
]
testpaths = ["src/test_*"{% if not python.vars.testpackage_name.startswith('test_') %}, {{ ('src/' ~ python.vars.testpackage_name) | tojson }}{% endif %}]
{%- if python.vars.package_name and not python.vars.has_distribution %}
pythonpath = ["src"]
{%- endif %}

[tool.coverage.run]
branch = true
omit = ["test_*"{% if not python.vars.testpackage_name.startswith('test_') %}, {{ ('src/' ~ python.vars.testpackage_name ~ '/*') | tojson }}{% endif %}]

[tool.coverage.report]
show_missing = true
{%- endif %}

{%- if 'ruff' in python.vars.tools %}

[tool.ruff]
src = ["src"]
exclude = [
    ".git",
    "__pycache__",
    "*/.ipynb_checkpoints/*.py",
]
line-length = 200
indent-width = 4

[tool.ruff.lint]
extend-select = [
    "D",    # pydocstyle
    "N",    # pep8-naming
    "Q",    # flake8-quotes
    "COM",  # flake8-commas
    "C4",   # flake8-comprehensions
    "FIX",  # flake8-fixme
    "PTH",  # flake8-use-pathlib
]
ignore = [
    "D212",  # multi-line docstring summary should start at the first line
]

[tool.ruff.lint.flake8-quotes]
inline-quotes = "single"

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.format]
quote-style = "single"
{%- endif %}

{%- if 'mypy' in python.vars.tools %}

[tool.mypy]
files = ["src"]
strict = true
{%- endif %}
{% endfilter %}
{% endif -%}
